{
  "name": "suara-cue",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Suara — live music cue desk",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "electron": "electron .",
    "dist:linux": "npm run build && electron-builder --linux tar.gz",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "build": {
    "directories": {"output": "dist-electron"},
    "appId": "com.za.sidqi.suara.cue",
    "productName": "Suara Cue",
    "files": ["dist/**/*", "electron/**/*"],
    "linux": {"target": ["tar.gz"], "category": "Audio"},
    "win": {"target": ["nsis"]}
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2"
  }
}
